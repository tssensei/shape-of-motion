+def load_calib_K(calib_path, image_list):
+  """Load full-resolution intrinsics from a SOM calibration JSON."""
+  with open(calib_path, "r") as f:
+    calib = json.load(f)
+
+  values = []
+  for image_file in image_list:
+    stem = os.path.splitext(os.path.basename(image_file))[0]
+    if stem not in calib:
+      raise KeyError(f"Missing intrinsics for frame {stem} in {calib_path}")
+    values.append(calib[stem][:4])
+
+  fx, fy, cx, cy = np.median(np.asarray(values, dtype=np.float32), axis=0)
+  K = np.eye(3)
+  K[0, 0] = fx
+  K[1, 1] = fy
+  K[0, 2] = cx
+  K[1, 2] = cy
+  return K
+
+
+def load_tracking_mask(mask_path, image_file, mask_fg_weight):
+  """Load a SOM foreground mask and convert it to tracking weights."""
+  stem = os.path.splitext(os.path.basename(image_file))[0]
+  candidates = [
+      os.path.join(mask_path, stem + ext)
+      for ext in [".png", ".jpg", ".jpeg", ".npy"]
+  ]
+  mask_file = next((path for path in candidates if os.path.exists(path)), None)
+  if mask_file is None:
+    raise FileNotFoundError(
+        "Missing mask for frame {} in {}".format(stem, mask_path)
+    )
+
+  if mask_file.endswith(".npy"):
+    raw_mask = np.load(mask_file)
+  else:
+    raw_mask = cv2.imread(mask_file, cv2.IMREAD_UNCHANGED)
+    if raw_mask is None:
+      raise FileNotFoundError(mask_file)
+
+  if raw_mask.ndim == 3:
+    fg_mask = raw_mask.reshape((*raw_mask.shape[:2], -1)).max(axis=-1) > 0
+  else:
+    fg_mask = raw_mask > 0
+
+  tracking_mask = np.ones_like(fg_mask, dtype=np.float32)
+  tracking_mask[fg_mask] = mask_fg_weight
+  return tracking_mask
+
+
