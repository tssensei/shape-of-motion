+def load_calib_K(calib_path, image_list):
+  """Load full-resolution intrinsics from a SOM calibration JSON."""
+  with open(calib_path, "r") as f:
+    calib = json.load(f)
+
+  values = []
+  for image_file in image_list:
+    stem = os.path.splitext(os.path.basename(image_file))[0]
+    if stem not in calib:
+      raise KeyError(f"Missing intrinsics for frame {stem} in {calib_path}")
+    values.append(calib[stem][:4])
+
+  fx, fy, cx, cy = np.median(np.asarray(values, dtype=np.float32), axis=0)
+  K = np.eye(3)
+  K[0, 0] = fx
+  K[1, 1] = fy
+  K[0, 2] = cx
+  K[1, 2] = cy
+  return K
+
